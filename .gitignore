.firecrawl/

# Dependencies, builds, caches and machine-local configuration
**/node_modules/
**/dist/
**/target/
**/__pycache__/
*.pyc
*.log
**/.env
**/.env.*
!**/.env.example
*.local
.idea/
.vscode/

# Source-only repository: no campus assets, source imagery, GIS or database data
/blender/
/database/*
!/database/docker-compose.yml
/diagnostics/
/frames/
/geojson/
/output/
/reference/
/web/docs/
/web/public/data/
/web/public/models/
*.glb
*.gltf
*.blend
*.blend1
*.fbx
*.obj
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.tif
*.tiff
*.gpkg
*.sqlite*
*.dump
*.backup
*.zip
*.tar
*.gz
*.7z
/campus_*report.json

# Campus-specific parameter/geometry datasets are also data, even in source files
/web/src/gis/three/*Manifest.json
/web/src/gis/features/CampusAcademicPlan.ts
/web/src/gis/features/CampusDormitoryCompounds.ts
/web/src/gis/features/CampusDormitoryShapeReview.ts
/web/src/gis/features/CampusMapNames.ts
/web/src/gis/features/CampusPlanDispositions.ts
/web/src/gis/features/CampusRemainingPlan.ts
/web/src/gis/features/CampusResidentialBatchV004.ts
/web/src/gis/features/CampusResidentialPlan.ts
/web/src/gis/features/CampusSouthwestPlan.ts
/web/src/gis/features/TeachingBuildingPresentation.ts
/web/src/gis/features/TeachingPlanGeometry.ts
/web/src/gis/layers/CampusDisplayGeometry.ts
/web/src/gis/layers/CampusAcademicRefinement.ts
/web/src/gis/layers/CampusPlanRoofGroups.ts
/web/scripts/
/scripts/*
!/scripts/prepare_brand_icons.py

# Operational records, releases, private certificates and authentication material
/infra/releases/
/infra/staging/
/infra/backup/
/infra/certs/
/infra/acme/
/infra/PRODUCTION_RUNBOOK.md
/infra/scripts/
/infra/docker/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*credentials*
*secret*
