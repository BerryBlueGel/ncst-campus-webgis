.firecrawl/

# Dependencies, builds, caches and machine-local configuration
**/node_modules/
**/dist/
**/target/
**/__pycache__/
*.pyc
*.log
**/.env
**/.env.*
!**/.env.example
*.local
.idea/
.vscode/

# Source-only repository: no campus assets, source imagery, GIS or database data
/blender/
/database/*
!/database/docker-compose.yml
/diagnostics/**
!/diagnostics/**/
!/diagnostics/**/*.js
!/diagnostics/**/*.mjs
!/diagnostics/**/*.html
!/diagnostics/**/package.json
!/diagnostics/**/package-lock.json
/frames/
/geojson/
/output/
/reference/**
!/reference/**/
!/reference/**/*.mjs
!/reference/**/*.html
/web/docs/
/web/public/data/
/web/public/models/
*.glb
*.gltf
*.blend
*.blend1
*.fbx
*.obj
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.tif
*.tiff
*.gpkg
*.sqlite*
*.dump
*.backup
*.zip
*.tar
*.gz
*.7z
/campus_*report.json

# Reviewed inline modeling parameters and source manifests are published with code.
# Runtime model/GIS files, raw imagery and generated reports remain excluded above.

# Operational records, releases, private certificates and authentication material
/infra/releases/
/infra/staging/
/infra/backup/
/infra/certs/
/infra/acme/
/infra/certbot-work/
/infra/certbot-logs/
/infra/PRODUCTION_RUNBOOK.md
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*credentials*
*secret*
